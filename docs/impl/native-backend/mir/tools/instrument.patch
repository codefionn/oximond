+/// Instrumentation for the latency study: exact per-thread user instruction
+/// counts at named points, printed when `OXIMOND_JIT_TRACE` is set.
+#[allow(unsafe_code)]
+pub mod lat {
+    use std::cell::Cell;
+    thread_local! {
+        static FD: Cell<i32> = const { Cell::new(-2) };
+        static OVER: Cell<u64> = const { Cell::new(0) };
+        static TID: Cell<i64> = const { Cell::new(0) };
+        static NATIVE: Cell<u64> = const { Cell::new(0) };
+    }
+    unsafe extern "C" {
+        fn syscall(number: i64, ...) -> i64;
+        fn read(fd: i32, buf: *mut u8, count: usize) -> isize;
+        fn getrusage(who: i32, usage: *mut [i64; 18]) -> i32;
+    }
+    /// Thread CPU time in microseconds, voluntary and involuntary switches.
+    #[allow(unsafe_code)]
+    fn usage() -> (i64, i64, i64) {
+        let mut ru = [0i64; 18];
+        // SAFETY: RUSAGE_THREAD = 1; struct rusage is 18 words on x86-64 Linux.
+        unsafe { getrusage(1, &mut ru) };
+        (ru[0] * 1_000_000 + ru[1] + ru[2] * 1_000_000 + ru[3], ru[16], ru[17])
+    }
+    #[allow(unsafe_code)]
+    fn raw() -> u64 {
+        FD.with(|fd| {
+            if fd.get() == -2 {
+                let mut attr = [0u64; 16];
+                attr[0] = 0 | (128u64 << 32); // PERF_TYPE_HARDWARE, size 128
+                attr[1] = 1; // PERF_COUNT_HW_INSTRUCTIONS
+                attr[5] = (1 << 5) | (1 << 6); // exclude_kernel, exclude_hv
+                // SAFETY: perf_event_open(attr, pid 0, cpu -1, group -1, flags 0).
+                let n = unsafe { syscall(298, attr.as_ptr(), 0i32, -1i32, -1i32, 0u64) };
+                fd.set(n as i32);
+                TID.with(|t| t.set(unsafe { syscall(186) }));
+            }
+            if fd.get() < 0 {
+                return 0;
+            }
+            let mut value = 0u64;
+            // SAFETY: reads 8 bytes into a local.
+            unsafe { read(fd.get(), (&raw mut value).cast(), 8) };
+            value
+        })
+    }
+    /// Runs `f`, a call into native trace code, and adds the instructions it
+    /// took (generated code plus the helpers it calls) to the thread's
+    /// native total.
+    pub fn around<R>(f: impl FnOnce() -> R) -> R {
+        if !super::debug_env::trace() {
+            return f();
+        }
+        let a = raw();
+        let r = f();
+        let b = raw();
+        NATIVE.with(|n| n.set(n.get() + (b - a)));
+        r
+    }
+    /// Prints `name` with the thread's instruction count so far, minus what
+    /// earlier calls to this function spent printing.
+    pub fn ev(name: &str) {
+        if !super::debug_env::trace() {
+            return;
+        }
+        let before = raw();
+        let adjusted = before - OVER.with(Cell::get);
+        let tid = TID.with(Cell::get);
+        let (cpu, vcs, ivcs) = usage();
+        eprintln!(
+            "jit-lat: ev {name} tid={tid} ic={adjusted} nat={} cpu={cpu} vcs={vcs} ivcs={ivcs} t={:?}",
+            NATIVE.with(Cell::get),
+            std::time::Instant::now()
+        );
+        let after = raw();
+        OVER.with(|o| o.set(o.get() + (after - before)));
+    }
+    /// Prints a start event now and an end event when dropped.
+    pub struct Span(&'static str);
+    pub fn span(name: &'static str) -> Span {
+        ev(&format!("{name}:b"));
+        Span(name)
+    }
+    impl Drop for Span {
+        fn drop(&mut self) {
+            ev(&format!("{}:e", self.0));
+        }
+    }
+}

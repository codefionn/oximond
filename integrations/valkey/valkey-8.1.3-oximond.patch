+        else if (!strcmp(execution, "tracing")) mode = 1;
+        else serverPanic("Unknown Oximond execution mode");
+    }
+    lua_State *state = oximond_newstate_with_options(NULL, NULL, selected, mode);
+    serverAssert(state != NULL);

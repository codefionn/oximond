+static void luaRestrictOximondGlobals(lua_State *lua) {
+    int count = 0;
+    lua_pushvalue(lua, LUA_GLOBALSINDEX);
+    lua_newtable(lua);
+    lua_pushnil(lua);
+    while (lua_next(lua, -3)) {
+        int allowed = 0;
+        const char *name = lua_tostring(lua, -2);
+        for (char ***list = allow_lists; name && *list && !allowed; ++list) {
+            for (char **entry = *list; *entry; ++entry) {
+                if (!strcmp(name, *entry)) { allowed = 1; break; }
+            }
+        }
+        if (!allowed) {
+            lua_pushvalue(lua, -2);
+            lua_rawseti(lua, -4, ++count);
+        }
+        lua_pop(lua, 1);
+    }
+    for (int i = 1; i <= count; ++i) {
+        lua_rawgeti(lua, -1, i);
+        lua_pushnil(lua);
+        lua_rawset(lua, -4);
+    }
+    lua_pop(lua, 2);
+}

diff --git a/src/script/cpp_api/s_base.cpp b/src/script/cpp_api/s_base.cpp
index 812d530..7c36c8a 100644
--- a/src/script/cpp_api/s_base.cpp
+++ b/src/script/cpp_api/s_base.cpp
@@ -79,9 +79,19 @@ ScriptApiBase::ScriptApiBase(ScriptingType type):
 		luaL_openlibs(m_luastack);
 
 	// Load bit library
-	lua_pushcfunction(m_luastack, luaopen_bit);
-	lua_pushstring(m_luastack, LUA_BITLIBNAME);
-	lua_call(m_luastack, 1, 0);
+#if USE_OXIMOND
+	// Oximond's LuaJIT dialect has a native bit library; keep it instead of
+	// replacing it with C functions called through the C API.
+	lua_getglobal(m_luastack, LUA_BITLIBNAME);
+	const bool have_bit = !lua_isnil(m_luastack, -1);
+	lua_pop(m_luastack, 1);
+	if (!have_bit)
+#endif
+	{
+		lua_pushcfunction(m_luastack, luaopen_bit);
+		lua_pushstring(m_luastack, LUA_BITLIBNAME);
+		lua_call(m_luastack, 1, 0);
+	}
 
 	// Load string.{pack,unpack,packsize}
 	setup_lstrpack(m_luastack);
@@ -107,7 +117,7 @@ ScriptApiBase::ScriptApiBase(ScriptingType type):
 	lua_pushlightuserdata(m_luastack, (void*) script_exception_wrapper);
 	luaJIT_setmode(m_luastack, -1, LUAJIT_MODE_WRAPCFUNC | LUAJIT_MODE_ON);
 	lua_pop(m_luastack, 1);
-#else
+#elif !USE_OXIMOND
 	// (This is a custom API from the bundled Lua.)
 	lua_atccall(m_luastack, script_exception_wrapper);
 #endif

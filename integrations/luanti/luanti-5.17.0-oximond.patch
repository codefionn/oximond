diff --git a/cmake/Modules/FindLua.cmake b/cmake/Modules/FindLua.cmake
index a239046..24200de 100644
--- a/cmake/Modules/FindLua.cmake
+++ b/cmake/Modules/FindLua.cmake
@@ -2,12 +2,31 @@
 # This selects LuaJIT by default
 
 option(ENABLE_LUAJIT "Enable LuaJIT support" TRUE)
+option(ENABLE_OXIMOND "Use the Oximond Lua 5.1 engine" FALSE)
 set(USE_LUAJIT FALSE)
+set(USE_OXIMOND FALSE)
 option(REQUIRE_LUAJIT "Require LuaJIT support" FALSE)
 if(REQUIRE_LUAJIT)
 	set(ENABLE_LUAJIT TRUE)
 endif()
-if(ENABLE_LUAJIT)
+if(ENABLE_OXIMOND)
+	if(NOT OXIMOND_LIBRARY OR NOT EXISTS "${OXIMOND_LIBRARY}")
+		message(FATAL_ERROR "ENABLE_OXIMOND requires OXIMOND_LIBRARY pointing to liboximond_capi.a")
+	endif()
+	set(USE_OXIMOND TRUE)
+	set(LUA_INCLUDE_DIR "${CMAKE_SOURCE_DIR}/lib/lua/src")
+	set(OXIMOND_BRIDGE "${CMAKE_SOURCE_DIR}/../../../crates/oximond-capi/bridge.cpp" CACHE FILEPATH "Oximond C++ exception bridge")
+	if(NOT EXISTS "${OXIMOND_BRIDGE}")
+		message(FATAL_ERROR "Oximond bridge not found: ${OXIMOND_BRIDGE}")
+	endif()
+	add_library(oximond_lua_aux STATIC
+		"${CMAKE_SOURCE_DIR}/lib/lua/src/lauxlib.c"
+		"${OXIMOND_BRIDGE}")
+	set_source_files_properties("${CMAKE_SOURCE_DIR}/lib/lua/src/lauxlib.c" PROPERTIES LANGUAGE CXX)
+	target_include_directories(oximond_lua_aux PRIVATE "${LUA_INCLUDE_DIR}")
+	set(LUA_LIBRARY oximond_lua_aux "${OXIMOND_LIBRARY}")
+	message(STATUS "Using Oximond: ${OXIMOND_LIBRARY}")
+elseif(ENABLE_LUAJIT)
 	find_package(LuaJIT)
 	if(LUAJIT_FOUND)
 		set(USE_LUAJIT TRUE)
@@ -20,7 +39,7 @@ else()
 	message (STATUS "LuaJIT detection disabled! (ENABLE_LUAJIT=0)")
 endif()
 
-if(NOT USE_LUAJIT)
+if(NOT USE_LUAJIT AND NOT USE_OXIMOND)
 	message(STATUS "LuaJIT not found, using bundled Lua.")
 	set(LUA_LIBRARY lua)
 	set(LUA_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/lib/lua/src)
